rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if owns(userId);
    }

    match /missions/{missionId} {
      allow read: if true;
      allow write: if signedIn() && request.auth.token.admin == true;
    }

    match /dailyChallenges/{challengeId} {
      allow read: if true;
      allow write: if signedIn() && request.auth.token.admin == true;
    }

    match /leaderboards/{boardId}/users/{userId} {
      allow read: if true;
      allow write: if owns(userId);
    }
  }
}
